# ============================================================
# .env.example — kaori_kabu のローカル環境変数雛形
# ============================================================
# 使い方:
#   1. このファイルを `.env` にコピー
#   2. 実際の値を埋める
# セキュリティ:
#   - 公開リポジトリには push しないこと
#   - .env を git に commit しないこと

# === アプリ基本 ===
APP_ENV=development
LOG_LEVEL=info
TZ=Asia/Tokyo
STREAMLIT_PORT=8501

# === ベース通貨設定 ===
BASE_CURRENCY=JPY
USDJPY_FALLBACK=150.0

# === データソース：株価・ファンダメンタル ===

# EODHD All World ($19.99/月、必須・米国+日本+60取引所)
# https://eodhd.com から取得
EODHD_API_KEY=

# J-Quants Light (月1,650円、必須・日本株の正本)
# https://jpx-jquants.com から取得
JQUANTS_REFRESH_TOKEN=
JQUANTS_PLAN=light

# === データソース：13F・インサイダー（無料） ===

# SEC EDGAR (無料、米国 13F・Form 4・10-K/Q)
# User-Agent ヘッダ必須。フォーマット: "Your Name your@email.com"
SEC_EDGAR_USER_AGENT=

# WhaleWisdom 無料枠 (オプション、13F 補完)
# WHALEWISDOM_API_KEY=

# === データソース：マクロ・経済指標（無料） ===

# FRED (無料、米連銀、必須)
# https://fred.stlouisfed.org/docs/api/api_key.html で発行
FRED_API_KEY=

# e-Stat (無料、日本政府統計)
# https://www.e-stat.go.jp/api/ で発行
ESTAT_APP_ID=

# === データソース：予測市場（無料） ===
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com

# Kalshi API（規制下の予測市場、オプション）
# KALSHI_API_KEY=
# KALSHI_API_SECRET=

# === データソース：ニュース・センチメント（オプション） ===
# NEWSAPI_KEY=
# FINNHUB_API_KEY=

# === LLM API (グローバル ~/.claude/.env にあれば不要) ===
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# === 検索 API (グローバル ~/.claude/.env にあれば不要) ===
# EXA_API_KEY=
# TAVILY_API_KEY=

# === キャッシュ・ストレージ ===
CACHE_DIR=./data/cache
HOLDINGS_FILE=./data/holdings/portfolio.csv
DECISION_LOG_DIR=./data/decision-log

# キャッシュ TTL（秒）
CACHE_TTL_EOD=86400
CACHE_TTL_FUNDAMENTAL=604800
CACHE_TTL_13F=7776000
CACHE_TTL_NEWS=3600

# === レート制限（API 呼び出し抑制）===
RATE_LIMIT_EODHD=1000
RATE_LIMIT_JQUANTS=60
RATE_LIMIT_SEC_EDGAR=10
RATE_LIMIT_FRED=120

# === 戦略パラメータ（デフォルト値）===

# Magic Formula
MF_MIN_MARKET_CAP_USD=100000000
MF_EXCLUDE_SECTORS=Financials,Utilities,Energy
MF_TOP_N=30
MF_REBALANCE_QUARTERS=4

# Half-Kelly ポジションサイザー
KELLY_FRACTION=0.5
KELLY_MAX_POSITION_PCT=0.05
KELLY_CASH_RESERVE_PCT=0.10

# ATR トレーリングストップ
ATR_PERIOD=14
ATR_MULTIPLIER=2.5
TRAILING_STOP_LOOKBACK=20

# Monte Carlo
MC_SIMULATIONS=1000
MC_HORIZON_DAYS=252

# HMM レジーム検出
HMM_N_STATES=3
HMM_LOOKBACK_DAYS=504

# === 13F Cloning 追跡対象ファンド（CIK） ===
# Berkshire Hathaway: 0001067983
# Pabrai Investment Funds: 0001173334
# Scion Asset Management (Burry): 0001649339
# Pershing Square (Ackman): 0001336528
# Greenlight Capital (Einhorn): 0001079114
TRACKED_FUNDS_CIK=0001067983,0001173334,0001649339,0001336528,0001079114

# === Obsidian vault 連携 ===
VAULT_PATH=/Users/kaori/Desktop/Obsidian/HOSODA_2nd_Brain
VAULT_PROJECT_NOTE=notes/projects/kaori_kabu.md

# === 開発フラグ ===
# DEBUG=
# DRY_RUN=false
# MOCK_DATA=false
